@startuml
skinparam actorStyle awesome
skinparam componentStyle rectangle
skinparam shadowing false

top to bottom direction

package "Client Browser" {
  actor User
  collections "Mining Modules\nRandomX.js/BTC Regtest\n(JS/WASM)" as Miner
  component "Worker Engine" as Worker
}

package "Framework Core" {
  component "Gateway" as Gateway
  component "Task Orchestrator" as Orchestrator
  component "Result Service" as ResultService
}

package "Abstraction Layer" {
  component "Task Generator Interface" as TaskIF
  component "Validation Interface" as ValidationIF
}

package "Payload Modules" {
  component "Custom Monero Stratum Adapter" as MoneroAdapter
  component "Custom BTC Regtest Client" as BTCRegtestClient
}

package "External Providers" {
  component "P2Pool Monero\n(RandomX Mining Pool)" as P2Pool
  component "BTC Regtest Node" as BTCRegtest
}

User --> Gateway: Request

Gateway -> Orchestrator
ResultService -> Gateway

Miner <-down-> Worker
Orchestrator -up-> Worker: Task

Worker -down-> ResultService: \rResult

ResultService <-down-> ValidationIF
Orchestrator <-down-> TaskIF

TaskIF <-down-> MoneroAdapter
ValidationIF <-down-> BTCRegtestClient

TaskIF <-down-> BTCRegtestClient
ValidationIF <-down-> MoneroAdapter

MoneroAdapter <-down-> P2Pool: Stratum
BTCRegtestClient <-down-> BTCRegtest: JSON-RPC
@enduml
